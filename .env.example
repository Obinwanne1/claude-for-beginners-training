# Server
PORT=3000

# Resend API (https://resend.com)
RESEND_API_KEY=re_your_api_key_here

# Sender display info
# Free tier: use onboarding@resend.dev as FROM_EMAIL
# Custom domain: use your verified domain email
FROM_NAME=Greenfield Training
FROM_EMAIL=onboarding@resend.dev

# Cron schedule (default: 9am daily)
# Format: minute hour day month weekday
# Examples:
#   0 9 * * *      = every day at 9:00am
#   0 9 * * 1-5    = weekdays at 9:00am
#   0 9 * * 1      = every Monday at 9:00am
LESSON_CRON=0 9 * * *
