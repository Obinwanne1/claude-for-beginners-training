# Server
PORT=3000

# SMTP — use Gmail App Password or any SMTP provider
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password_here

# Sender display info
FROM_NAME=Greenfield Training
FROM_EMAIL=training@greenfield.com

# Cron schedule (default: 9am daily)
# Format: minute hour day month weekday
# Examples:
#   0 9 * * *      = every day at 9:00am
#   0 9 * * 1-5    = weekdays at 9:00am
#   0 9 * * 1      = every Monday at 9:00am
LESSON_CRON=0 9 * * *
